            ]
           },
           "max": {
            "type": [
             "number",
             "null"
            ]
           }
          }
         },
         "confidenceAgreement": {
          "type": [
           "number",
           "null"
          ]
         },
         "threshold4Agreement": {
          "type": [
           "number",
           "null"
          ]
         },
         "matchSignalsOverlap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "n",
           "mean",
           "median",
           "p90",
           "max"
          ],
          "properties": {
           "n": {
            "type": [
             "number",
             "null"
            ]
           },
           "mean": {
            "type": [
             "number",
             "null"
            ]
           },
           "median": {
            "type": [
             "number",
             "null"
            ]
           },
           "p90": {
            "type": [
             "number",
             "null"
            ]
           },
           "max": {
            "type": [
             "number",
             "null"
            ]
           }
          }
         },
         "mainRiskOverlap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "n",
           "mean",
           "median",
           "p90",
           "max"
          ],
          "properties": {
           "n": {
            "type": [
             "number",
             "null"
            ]
           },
           "mean": {
            "type": [
             "number",
             "null"
            ]
           },
           "median": {
            "type": [
             "number",
             "null"
            ]
           },
           "p90": {
            "type": [
             "number",
             "null"
            ]
           },
           "max": {
            "type": [
