{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "batch-v2-ab.schema.json",
 "title": "Batch runner v2 dry-run A/B sample and result (AIR-449)",
 "description": "Machine-readable contract of the owner-approved dry-run experiment of AIR-450. Nothing here is written to production state. A metric the platform does not show is null and named in telemetry.unavailable; it is never estimated. A result record contains the raw model outputs (films[].fingerprint and films[].prediction): it is private and stays in the owner-controlled trial storage; only sanitized aggregates may be published.",
 "$defs": {
  "sample": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schemaVersion",
    "sampleId",
    "filmIds",
    "frozenAt",
    "source"
   ],
   "properties": {
    "schemaVersion": {
     "const": 1
    },
    "sampleId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 80
    },
    "filmIds": {
     "type": "array",
     "minItems": 1,
     "maxItems": 100,
     "uniqueItems": true,
     "items": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
     }
    },
    "frozenAt": {
     "type": "string",
     "minLength": 10
    },
    "source": {
     "type": "string",
     "minLength": 1
    },
    "approvedBy": {
     "type": "string"
    },
    "manifestHash": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "result": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schemaVersion",
    "sampleId",
    "groupSize",
    "manifestHash",
    "profile",
    "contract",
    "films",
    "calls",
    "telemetry"
   ],
   "properties": {
    "schemaVersion": {
     "const": 1
    },
    "sampleId": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "groupSize": {
     "type": "integer",
     "minimum": 1,
     "maximum": 10
    },
    "promptSha256": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^[0-9a-f]{64}$"
    },
    "manifestHash": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "profile": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "version",
      "hash"
     ],
     "properties": {
      "version": {
       "type": "integer",
       "minimum": 1
      },
      "hash": {
       "type": "string",
       "pattern": "^[0-9a-f]{8,64}$"
      }
     }
    },
    "contract": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "fingerprintSchemaVersion",
      "fingerprintPromptVersion",
      "predictionPromptVersion",
      "registryDigest"
     ],
     "properties": {
      "fingerprintSchemaVersion": {
       "type": "integer"
      },
      "fingerprintPromptVersion": {
       "type": "integer"
      },
      "predictionPromptVersion": {
       "type": "integer"
      },
      "registryDigest": {
       "type": "string",
       "pattern": "^[0-9a-f]{8,64}$"
      }
     }
    },
    "films": {
     "type": "array",
     "minItems": 1,
     "maxItems": 100,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "filmId",
       "plan",
       "groupIndex",
       "prediction",
       "submitStatus",
       "liveInput",
       "validation",
       "callId"
      ],
      "properties": {
       "filmId": {
        "type": "string",
        "pattern": "^[a-z0-9_-]{1,40}$"
       },
       "plan": {
        "enum": [
         "fingerprint_and_prediction",
         "prediction_only"
        ]
       },
       "groupIndex": {
        "type": "integer",
        "minimum": 0
       },
       "fingerprint": {
        "type": [
         "object",
         "null"
        ]
       },
       "prediction": {
        "type": [
         "object",
         "null"
        ]
       },
       "submitStatus": {
        "enum": [
         "would_write",
         "already_current",
         "not_eligible",
         "validation_failure",
         "not_submitted"
        ]
       },
       "liveInput": {
        "enum": [
         "same",
         "changed",
         "not_eligible",
         "unknown"
        ]
       },
       "validation": {
        "type": [
         "object",
         "null"
        ],
        "additionalProperties": false,
        "required": [
         "stage",
         "issues"
        ],
        "properties": {
         "stage": {
          "enum": [
           "caller_reported",
           "fingerprint_schema",
           "fingerprint_missing",
           "prediction_schema"
          ]
         },
         "issues": {
          "type": "array",
          "items": {
           "type": "object",
           "additionalProperties": false,
           "required": [
            "path",
            "code"
           ],
           "properties": {
            "path": {
             "type": "string"
            },
            "code": {
             "type": "string"
            }
           }
          }
         }
        }
       },
       "generationMs": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "callId": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0,
        "description": "Index of the call (calls[].callId) whose answer recorded this film's result; null for a not_submitted film. A group split over several calls gives each film its own call."
       }
      }
     }
    },
    "calls": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "groupIndex",
       "itemCount",
       "ok",
       "observedProfileHash",
       "callId"
      ],
      "properties": {
       "groupIndex": {
        "type": "integer",
        "minimum": 0
       },
       "itemCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       },
       "bodyBytes": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "toolMs": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "ok": {
        "type": "boolean"
       },
       "error": {
        "type": [
         "string",
         "null"
        ]
       },
       "observedProfileHash": {
        "type": [
         "string",
         "null"
        ],
        "pattern": "^[0-9a-f]{8,64}$",
        "description": "profile.hash of the dry-run submit answer; the pass compares it with the manifest profile hash and stops with profile_moved on a difference."
       },
       "callId": {
        "type": "integer",
        "minimum": 0,
        "description": "Unique, in the order the calls were made. A retry, a refusal or one call per film of a split group is a call of its own."
       }
      }
     }
    },
    "telemetry": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "model",
      "tokens",
      "quota",
      "wallMs",
      "unavailable"
     ],
     "properties": {
      "model": {
       "type": [
        "string",
        "null"
       ]
      },
      "tokens": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": false,
       "required": [
        "input",
        "output"
       ],
       "properties": {
        "input": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0
        },
        "output": {
         "type": [
          "integer",
          "null"
         ],
         "minimum": 0
        }
       }
      },
      "quota": {
       "type": [
        "object",
        "null"
       ],
       "additionalProperties": false,
       "required": [
        "remainingPercentBefore",
        "remainingPercentAfter"
       ],
       "properties": {
        "remainingPercentBefore": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0,
         "maximum": 100
        },
        "remainingPercentAfter": {
         "type": [
          "number",
          "null"
         ],
         "minimum": 0,
         "maximum": 100
        }
       }
      },
      "wallMs": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0
      },
      "unavailable": {
       "type": "array",
       "items": {
        "enum": [
         "model",
         "tokens",
         "quota",
         "wallMs",
         "generationMs",
         "toolMs",
         "bodyBytes"
        ]
       }
      }
     }
    },
    "notes": {
     "type": "string"
    },
    "stoppedReason": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "profile_moved",
      "manifest_invalid",
      "size_refused",
      null
     ]
    }
   }
  },
  "report": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schemaVersion",
    "kind",
    "identity",
    "completeness",
    "quality",
    "perSize",
    "stability",
    "unknown",
    "model"
   ],
   "description": "Sanitized aggregate of the ten passes, built field by field by scripts/prediction-ab-report.mjs from validated input records. Every object is closed and every string is a fixed enum, a hex hash, a short owner label or a film id: it holds no fingerprint, prediction, metadata, free text or value copied from a private string. It is the one record that may leave the private trial storage after a privacy review, and a partial report is a diagnostic, never the final AIR-450 comparison.",
   "properties": {
    "schemaVersion": {
     "const": 1
    },
    "kind": {
     "const": "prediction_batch_v2_ab_report"
    },
    "identity": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "sampleId",
      "manifestHash",
      "profile",
      "contract",
      "films",
      "sizes",
      "baselineSize"
     ],
     "properties": {
      "sampleId": {
       "type": "string",
       "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      },
      "manifestHash": {
       "type": "string",
       "pattern": "^[0-9a-f]{64}$"
      },
      "profile": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "version",
        "hash"
       ],
       "properties": {
        "version": {
         "type": "integer",
         "minimum": 1
        },
        "hash": {
         "type": "string",
         "pattern": "^[0-9a-f]{8,64}$"
        }
       }
      },
      "contract": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "fingerprintSchemaVersion",
        "fingerprintPromptVersion",
        "predictionPromptVersion",
        "registryDigest"
       ],
       "properties": {
        "fingerprintSchemaVersion": {
         "type": "integer"
        },
        "fingerprintPromptVersion": {
         "type": "integer"
        },
        "predictionPromptVersion": {
         "type": "integer"
        },
        "registryDigest": {
         "type": "string",
         "pattern": "^[0-9a-f]{8,64}$"
        }
       }
      },
      "films": {
       "type": "integer",
       "minimum": 1
      },
      "sizes": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       }
      },
      "baselineSize": {
       "type": [
        "integer",
        "null"
       ]
      }
     }
    },
    "completeness": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "allSizes",
      "missingSizes",
      "films",
      "final",
      "ownerAcceptance"
     ],
     "properties": {
      "allSizes": {
       "type": "boolean"
      },
      "missingSizes": {
       "type": "array",
       "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       }
      },
      "films": {
       "type": "integer"
      },
      "final": {
       "type": "boolean"
      },
      "ownerAcceptance": {
       "const": "required"
      }
     }
    },
    "quality": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "truth"
     ],
     "properties": {
      "truth": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "available",
        "films",
        "basis"
       ],
       "properties": {
        "available": {
         "type": "boolean"
        },
        "films": {
         "type": "integer",
         "minimum": 0
        },
        "basis": {
         "enum": [
          "hidden_user_ratings",
          "agreement_to_baseline_only"
         ]
        }
       }
      }
     }
    },
    "perSize": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "groupSize",
       "films",
       "statuses",
       "comparableFilms",
       "excluded",
       "validShare",
       "sizeRefusals",
       "profileMismatchCalls",
       "stoppedReason",
       "cost"
      ],
      "properties": {
       "groupSize": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
       },
       "films": {
        "type": "integer",
        "minimum": 1
       },
       "statuses": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "would_write",
         "already_current",
         "not_eligible",
         "validation_failure",
         "not_submitted"
        ],
        "properties": {
         "would_write": {
          "type": "integer",
          "minimum": 0
         },
         "already_current": {
          "type": "integer",
          "minimum": 0
         },
         "not_eligible": {
          "type": "integer",
          "minimum": 0
         },
         "validation_failure": {
          "type": "integer",
          "minimum": 0
         },
         "not_submitted": {
          "type": "integer",
          "minimum": 0
         }
        }
       },
       "comparableFilms": {
        "type": "integer",
        "minimum": 0
       },
       "excluded": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "liveInputChanged",
         "staleProfile",
         "notValid"
        ],
        "properties": {
         "liveInputChanged": {
          "type": "integer",
          "minimum": 0
         },
         "staleProfile": {
          "type": "integer",
          "minimum": 0
         },
         "notValid": {
          "type": "integer",
          "minimum": 0
         }
        }
       },
       "validShare": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "sizeRefusals": {
        "type": "integer",
        "minimum": 0
       },
       "profileMismatchCalls": {
        "type": "integer",
        "minimum": 0
       },
       "stoppedReason": {
        "type": [
         "string",
         "null"
        ],
        "enum": [
         "profile_moved",
         "manifest_invalid",
         "size_refused",
         null
        ]
       },
       "cost": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "mcpCalls",
         "bodyBytes",
         "toolMs",
         "generationMs",
         "wallMs",
         "tokens",
         "quota",
         "unavailable"
        ],
        "properties": {
         "mcpCalls": {
          "type": "integer",
          "minimum": 0
         },
         "bodyBytes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "total",
           "max"
          ],
          "properties": {
           "total": {
            "type": [
             "integer",
             "null"
            ],
            "minimum": 0
           },
           "max": {
            "type": [
             "integer",
             "null"
            ],
            "minimum": 0
           }
          }
         },
         "toolMs": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         },
         "generationMs": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         },
         "wallMs": {
          "type": [
           "integer",
           "null"
          ],
          "minimum": 0
         },
         "tokens": {
          "type": [
           "object",
           "null"
          ],
          "additionalProperties": false,
          "required": [
           "input",
           "output"
          ],
          "properties": {
           "input": {
            "type": [
             "integer",
             "null"
            ],
            "minimum": 0
           },
           "output": {
            "type": [
             "integer",
             "null"
            ],
            "minimum": 0
           }
          }
         },
         "quota": {
          "type": [
           "object",
           "null"
          ],
          "additionalProperties": false,
          "required": [
           "remainingPercentBefore",
           "remainingPercentAfter"
          ],
          "properties": {
           "remainingPercentBefore": {
            "type": [
             "number",
             "null"
            ],
            "minimum": 0,
            "maximum": 100
           },
           "remainingPercentAfter": {
            "type": [
             "number",
             "null"
            ],
            "minimum": 0,
            "maximum": 100
           }
          }
         },
         "unavailable": {
          "type": "array",
          "items": {
           "enum": [
            "model",
            "tokens",
            "quota",
            "wallMs",
            "generationMs",
            "toolMs",
            "bodyBytes"
           ]
          }
         }
        }
       },
       "truth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "n",
         "mae",
         "bias",
         "threshold4Accuracy"
        ],
        "properties": {
         "n": {
          "type": "integer",
          "minimum": 0
         },
         "mae": {
          "type": [
           "number",
           "null"
          ]
         },
         "bias": {
          "type": [
           "number",
           "null"
          ]
         },
         "threshold4Accuracy": {
          "type": [
           "number",
           "null"
          ]
         }
        }
       },
       "agreementToBaseline": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "pairs",
         "predictedRatingAbsDiff",
         "probability4PlusAbsDiff",
         "confidenceAgreement",
         "threshold4Agreement",
         "matchSignalsOverlap",
         "mainRiskOverlap",
         "executionAgreement",
         "plotMechanicsOverlap",
         "fingerprintPairs"
        ],
        "properties": {
         "pairs": {
          "type": "integer",
          "minimum": 0
         },
         "predictedRatingAbsDiff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "n",
           "mean",
           "median",
           "p90",
           "max"
          ],
          "properties": {
           "n": {
            "type": [
             "number",
             "null"
            ]
           },
           "mean": {
            "type": [
             "number",
             "null"
            ]
           },
           "median": {
            "type": [
             "number",
             "null"
            ]
           },
           "p90": {
            "type": [
             "number",
             "null"
            ]
           },
           "max": {
            "type": [
             "number",
             "null"
            ]
           }
          }
         },
         "probability4PlusAbsDiff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "n",
           "mean",
