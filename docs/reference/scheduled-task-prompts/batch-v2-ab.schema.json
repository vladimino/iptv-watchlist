               "null"
              ]
             }
            }
           },
           {
            "type": "null"
           }
          ]
         },
         "plotMechanicsOverlap": {
          "anyOf": [
           {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "n",
             "mean",
             "median",
             "p90",
             "max"
            ],
            "properties": {
             "n": {
              "type": [
               "number",
               "null"
              ]
             },
             "mean": {
              "type": [
               "number",
               "null"
              ]
             },
             "median": {
              "type": [
               "number",
               "null"
              ]
             },
             "p90": {
              "type": [
               "number",
               "null"
