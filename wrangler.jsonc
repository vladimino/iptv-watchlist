
{
  "name": "iptv",
  "main": "dist/server/workflow-entry.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "PREDICTION_DB_REQUIRED": "on",
    "RATINGS_DB_REQUIRED": "on",
    "EPG_DIAGNOSTIC_RESOURCE_ID": "epg-diag-20261112"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iptv",
      "database_id": "3fba0e0a-44e9-4a3a-a7ba-edaee6bcafcb"
    },
    {
      "binding": "EPG_DIAGNOSTIC_DB",
      "database_name": "iptv-epg-diagnostic",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iptv"
    },
    {
      "binding": "EPG_DIAGNOSTIC_BUCKET",
      "bucket_name": "iptv-epg-diagnostic"
    }
  ],
  "workflows": [
    {
      "name": "iptv-discovery",
      "binding": "DISCOVERY_WORKFLOW",
      "class_name": "DiscoveryWorkflow"
    },
    {
      "name": "iptv-ratings",
      "binding": "RATINGS_WORKFLOW",
      "class_name": "RatingsWorkflow"
    },
    {
      "name": "iptv-epg",
      "binding": "EPG_WORKFLOW",
      "class_name": "EpgWorkflow"
    },
    {
      "name": "iptv-epg-diagnostic",
      "binding": "EPG_DIAGNOSTIC_WORKFLOW",
      "class_name": "EpgDiagnosticWorkflow"
    }
  ]
}
