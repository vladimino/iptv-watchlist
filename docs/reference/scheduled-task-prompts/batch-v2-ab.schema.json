             "median",
             "p90",
             "max"
            ],
            "properties": {
             "n": {
              "type": [
               "number",
               "null"
              ]
             },
             "mean": {
              "type": [
               "number",
               "null"
              ]
             },
             "median": {
              "type": [
               "number",
               "null"
              ]
             },
             "p90": {
              "type": [
               "number",
               "null"
              ]
             },
             "max": {
