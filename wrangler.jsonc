
{
  "name": "iptv",
  "main": "dist/server/workflow-entry.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "PREDICTION_DB_REQUIRED": "on"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "triggers": {
    "crons": ["37 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iptv",
      "database_id": "3fba0e0a-44e9-4a3a-a7ba-edaee6bcafcb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iptv"
    }
  ],
  "workflows": [
    {
      "name": "iptv-discovery",
      "binding": "DISCOVERY_WORKFLOW",
      "class_name": "DiscoveryWorkflow"
    }
  ]
}
