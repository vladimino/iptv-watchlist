
{
  "name": "iptv",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iptv"
    }
  ]
}
