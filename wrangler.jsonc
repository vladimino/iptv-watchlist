
{
  "name": "iptv",
  "main": "dist/server/workflow-entry.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "PREDICTION_DB_REQUIRED": "on",
    "RATINGS_DB_REQUIRED": "on"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "limits": {
    "cpu_ms": 120000
  },
  "triggers": {
    "crons": ["0 * * * *", "1-59/2 * * * *", "24 3 * * *", "30 * * * *", "11-59/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iptv",
      "database_id": "3fba0e0a-44e9-4a3a-a7ba-edaee6bcafcb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "iptv"
    }
  ],
  "workflows": [
    {
      "name": "iptv-discovery",
      "binding": "DISCOVERY_WORKFLOW",
      "class_name": "DiscoveryWorkflow"
    },
    {
      "name": "iptv-epg",
      "binding": "EPG_WORKFLOW",
      "class_name": "EpgWorkflow"
    },
    {
      "name": "iptv-producer",
      "binding": "PRODUCER_WORKFLOW",
      "class_name": "ProducerWorkflow"
    },
    {
      "name": "iptv-letterboxd",
      "binding": "LETTERBOXD_WORKFLOW",
      "class_name": "LetterboxdWorkflow"
    },
    {
      "name": "iptv-prediction-start",
      "binding": "PREDICTION_START_WORKFLOW",
      "class_name": "PredictionStartWorkflow"
    },
    {
      "name": "iptv-catalog-enrichment",
      "binding": "CATALOG_ENRICHMENT_WORKFLOW",
      "class_name": "CatalogEnrichmentWorkflow"
    }
  ]
}
